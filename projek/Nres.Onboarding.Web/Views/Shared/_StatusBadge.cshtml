@model SubmissionStatus
@*
    One badge partial reused by every module, so a status always looks the same
    wherever it appears.
*@
@{
    var (css, label) = Model switch
    {
        SubmissionStatus.Draft => ("text-bg-secondary", "Draf"),
        SubmissionStatus.Submitted => ("text-bg-warning", "Dihantar"),
        SubmissionStatus.SupervisorApproved => ("text-bg-info", "Lulus Penyelia"),
        SubmissionStatus.AdminApproved => ("text-bg-success", "Diluluskan"),
        SubmissionStatus.Rejected => ("text-bg-danger", "Ditolak"),
        SubmissionStatus.Completed => ("text-bg-success", "Selesai"),
        SubmissionStatus.Cancelled => ("text-bg-dark", "Dibatalkan"),
        _ => ("text-bg-light", Model.ToString())
    };
}
<span class="badge @css">@label</span>
