@*
    Sign-in / sign-out block for the navigation bar.
    Sign-out is a POST, not a link: a GET that changes state can be triggered by any
    image tag on any other site (CSRF).
*@
<ul class="navbar-nav">
    @if (User.Identity?.IsAuthenticated == true)
    {
        <li class="nav-item">
            <span class="nav-link text-dark">Log masuk sebagai <strong>@User.Identity!.Name</strong></span>
        </li>
        <li class="nav-item">
            <form class="d-inline" asp-controller="Account" asp-action="Logout" method="post">
                <button type="submit" class="btn btn-link nav-link text-dark">Log Keluar</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" asp-controller="Account" asp-action="Login">Log Masuk</a>
        </li>
    }
</ul>
