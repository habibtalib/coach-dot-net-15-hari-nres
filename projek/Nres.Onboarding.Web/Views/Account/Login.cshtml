@model LoginViewModel
@{
    ViewData["Title"] = "Log Masuk";
}

<div class="row justify-content-center">
    <div class="col-md-6 col-lg-5">
        <h1 class="h3 mb-3">Log Masuk</h1>

        <form asp-action="Login" method="post">
            <input type="hidden" asp-for="ReturnUrl" />
            <div asp-validation-summary="All" class="text-danger mb-3"></div>

            <div class="mb-3">
                <label asp-for="UserName" class="form-label"></label>
                <input asp-for="UserName" class="form-control" autocomplete="username" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Password" class="form-label"></label>
                <input asp-for="Password" class="form-control" autocomplete="current-password" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-check mb-3">
                <input asp-for="RememberMe" class="form-check-input" />
                <label asp-for="RememberMe" class="form-check-label"></label>
            </div>

            <button type="submit" class="btn btn-primary">Log Masuk</button>
        </form>

        @* Training only. A real system would never advertise credentials on the sign-in page. *@
        <div class="alert alert-secondary mt-4 small mb-0">
            <strong>Akaun demo (latihan sahaja):</strong>
            <ul class="mb-0">
                <li><code>applicant@@nres.demo</code> / <code>Password123!</code> &mdash; peranan Applicant</li>
                <li><code>hradmin@@nres.demo</code> / <code>Password123!</code> &mdash; peranan HrAdmin</li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
