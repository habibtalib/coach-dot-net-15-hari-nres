@{
    ViewData["Title"] = "Utama";
}

<div class="mb-4">
    <h1 class="display-6">Sistem Onboarding &amp; Khidmat Dalaman NRES</h1>
    <p class="text-muted mb-0">
        Satu aplikasi, empat modul permohonan, satu aliran kelulusan yang sama:
        <code>Draft &rarr; Submitted &rarr; Semakan &rarr; Lulus / Tolak &rarr; Audit</code>.
    </p>
</div>

@if (User.Identity?.IsAuthenticated == true)
{
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-secondary">
                <div class="card-body">
                    <h6 class="card-subtitle text-muted mb-2">Draf saya</h6>
                    <p class="display-6 mb-0">@(ViewData["MyDraftCount"] ?? 0)</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-secondary">
                <div class="card-body">
                    <h6 class="card-subtitle text-muted mb-2">Menunggu semakan</h6>
                    <p class="display-6 mb-0">@(ViewData["MySubmittedCount"] ?? 0)</p>
                </div>
            </div>
        </div>
        @if (User.IsInRole(ApplicationRoles.HrAdmin))
        {
            <div class="col-md-4">
                <div class="card border-primary">
                    <div class="card-body">
                        <h6 class="card-subtitle text-muted mb-2">Baris semakan HR</h6>
                        <p class="display-6 mb-0">@(ViewData["ReviewQueueCount"] ?? 0)</p>
                        <a asp-controller="OfficerReporting" asp-action="Review">Buka baris semakan</a>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">
        Sila <a asp-controller="Account" asp-action="Login">log masuk</a> untuk membuat atau menyemak permohonan.
    </div>
}

<h2 class="h4 mb-3">Modul sistem</h2>
<div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-3">
    <div class="col">
        <div class="card h-100 border-success">
            <div class="card-body">
                <h5 class="card-title">1 &middot; Lapor Diri</h5>
                <p class="card-text text-muted">Pendaftaran pegawai baharu, lampiran, semakan HR.</p>
                <span class="badge text-bg-success mb-2">Siap</span>
                <div><a class="btn btn-sm btn-outline-primary" asp-controller="OfficerReporting" asp-action="Index">Buka modul</a></div>
            </div>
        </div>
    </div>

    @* Modules 2-4 are built by Kumpulan 2, 3 and 4 during Hari 4-14. *@
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title text-muted">2 &middot; Pas, Parkir &amp; Pelekat</h5>
                <p class="card-text text-muted">Pas keselamatan, lot parkir, pelekat kenderaan, semakan QR.</p>
                <span class="badge text-bg-secondary">Kumpulan 2 &middot; Hari 4-14</span>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title text-muted">3 &middot; ID, AD &amp; Email</h5>
                <p class="card-text text-muted">Akaun rangkaian, emel rasmi, akses sistem, kelulusan dua peringkat.</p>
                <span class="badge text-bg-secondary">Kumpulan 3 &middot; Hari 4-14</span>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title text-muted">4 &middot; Perisian &amp; Aset ICT</h5>
                <p class="card-text text-muted">Katalog aset, lesen perisian, pinjaman dan pemulangan.</p>
                <span class="badge text-bg-secondary">Kumpulan 4 &middot; Hari 4-14</span>
            </div>
        </div>
    </div>
</div>
