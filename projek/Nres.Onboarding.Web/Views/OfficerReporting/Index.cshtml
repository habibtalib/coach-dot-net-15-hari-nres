@model IReadOnlyList<OfficerReportingListItemViewModel>
@{
    ViewData["Title"] = "Lapor Diri Saya";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h3 mb-0">Lapor Diri Saya</h1>
    <a class="btn btn-primary" asp-action="Create">Permohonan Baharu</a>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">
        Tiada permohonan lagi. Klik <strong>Permohonan Baharu</strong> untuk mula.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>No. Rujukan</th>
                    <th>Nama</th>
                    <th>Jabatan</th>
                    <th>Tarikh Lapor Diri</th>
                    <th>Status</th>
                    <th class="text-center">Lampiran</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><code>@item.ReferenceDisplay</code></td>
                    <td>@item.FullName</td>
                    <td>@item.DepartmentName</td>
                    <td>@item.ReportingDate.ToString("dd/MM/yyyy")</td>
                    <td><partial name="_StatusBadge" model="item.Status" /></td>
                    <td class="text-center">@item.AttachmentCount</td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@item.SubmissionId">Butiran</a>
                        @if (item.Status == SubmissionStatus.Draft)
                        {
                            <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@item.SubmissionId">Sunting</a>
                        }
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
