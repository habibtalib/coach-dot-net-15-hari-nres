@model IReadOnlyList<OfficerReportingListItemViewModel>
@{
    ViewData["Title"] = "Semakan HR - Lapor Diri";
    var currentFilter = ViewData["StatusFilter"] as SubmissionStatus? ?? SubmissionStatus.Submitted;

    var filters = new[]
    {
        (Status: SubmissionStatus.Submitted, Label: "Menunggu semakan"),
        (Status: SubmissionStatus.AdminApproved, Label: "Diluluskan"),
        (Status: SubmissionStatus.Rejected, Label: "Ditolak"),
        (Status: SubmissionStatus.Draft, Label: "Draf")
    };
}

<h1 class="h3 mb-3">Semakan HR &mdash; Lapor Diri</h1>

<ul class="nav nav-pills mb-3">
    @foreach (var filter in filters)
    {
        <li class="nav-item">
            <a class="nav-link @(filter.Status == currentFilter ? "active" : "")"
               asp-action="Review" asp-route-status="@filter.Status">@filter.Label</a>
        </li>
    }
</ul>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Tiada permohonan dalam kategori ini.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>No. Rujukan</th>
                    <th>Pemohon</th>
                    <th>Jabatan</th>
                    <th>Tarikh Lapor Diri</th>
                    <th>Dihantar</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td><code>@item.ReferenceDisplay</code></td>
                    <td>@item.FullName</td>
                    <td>@item.DepartmentName</td>
                    <td>@item.ReportingDate.ToString("dd/MM/yyyy")</td>
                    <td>@(item.SubmittedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</td>
                    <td><partial name="_StatusBadge" model="item.Status" /></td>
                    <td class="text-end">
                        <a class="btn btn-sm btn-outline-primary" asp-action="Details" asp-route-id="@item.SubmissionId">
                            Semak
                        </a>
                    </td>
                </tr>
            }
            </tbody>
        </table>
    </div>
}
