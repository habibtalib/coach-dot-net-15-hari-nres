@model OfficerReportingDetailsViewModel
@using Nres.Onboarding.Web.Services
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.ReferenceNo)
        ? "Butiran Draf Lapor Diri"
        : $"Lapor Diri {Model.ReferenceNo}";
}

<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1 class="h3 mb-1">
            @(string.IsNullOrWhiteSpace(Model.ReferenceNo) ? "Draf Lapor Diri" : Model.ReferenceNo)
        </h1>
        <partial name="_StatusBadge" model="Model.Status" />
        <span class="text-muted small ms-2">Pemohon: @Model.ApplicantDisplayName</span>
    </div>
    <div class="d-flex gap-2">
        @if (Model.CanEdit)
        {
            <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.SubmissionId">Sunting</a>
        }
        @if (Model.CanSubmit)
        {
            <form asp-action="Submit" asp-route-id="@Model.SubmissionId" method="post">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-primary">Hantar untuk Semakan</button>
            </form>
        }
        <a class="btn btn-outline-secondary" asp-action="Index">Senarai saya</a>
    </div>
</div>

@if (Model.CanReview)
{
    <partial name="_ReviewDecision" model="Model" />
}

<div class="row g-4">
    <div class="col-lg-7">
        <div class="card mb-4">
            <div class="card-header">Maklumat Pemohon</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.FullName)</dt>
                    <dd class="col-sm-7">@Model.FullName</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.IdentityNo)</dt>
                    <dd class="col-sm-7">@Model.IdentityNo</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Email)</dt>
                    <dd class="col-sm-7">@Model.Email</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.Phone)</dt>
                    <dd class="col-sm-7">@Model.Phone</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.DepartmentName)</dt>
                    <dd class="col-sm-7">@Model.DepartmentName</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.PositionName)</dt>
                    <dd class="col-sm-7">@Model.PositionName</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.GradeName)</dt>
                    <dd class="col-sm-7">@Model.GradeName</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.ReportingDate)</dt>
                    <dd class="col-sm-7">@Model.ReportingDate.ToString("dd/MM/yyyy")</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.PreviousAgency)</dt>
                    <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(Model.PreviousAgency) ? "-" : Model.PreviousAgency)</dd>

                    <dt class="col-sm-5">@Html.DisplayNameFor(m => m.EmergencyContact)</dt>
                    <dd class="col-sm-7">@(string.IsNullOrWhiteSpace(Model.EmergencyContact) ? "-" : Model.EmergencyContact)</dd>
                </dl>
            </div>
        </div>

        <div class="card mb-4">
            <div class="card-header">Lampiran</div>
            <div class="card-body">
                @if (Model.Attachments.Count == 0)
                {
                    <p class="text-muted mb-0">Tiada lampiran.</p>
                }
                else
                {
                    <ul class="list-group list-group-flush mb-0">
                        @foreach (var attachment in Model.Attachments)
                        {
                            <li class="list-group-item d-flex justify-content-between align-items-center px-0">
                                @* Files are streamed by a controller action, not linked
                                   statically - App_Data is outside wwwroot on purpose. *@
                                <a asp-action="DownloadAttachment" asp-route-id="@attachment.Id">
                                    @attachment.OriginalFileName
                                </a>
                                <span class="text-muted small">
                                    @attachment.SizeDisplay &middot; @attachment.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </span>
                            </li>
                        }
                    </ul>
                }
            </div>

            @if (Model.CanEdit)
            {
                <div class="card-footer">
                    <form asp-action="UploadAttachment" asp-route-id="@Model.SubmissionId"
                          method="post" enctype="multipart/form-data" class="row g-2 align-items-center">
                        @Html.AntiForgeryToken()
                        <div class="col-sm-8">
                            <input type="file" name="file" class="form-control"
                                   accept="@string.Join(",", FileUploadRules.AllowedExtensions)" required />
                        </div>
                        <div class="col-sm-4">
                            <button type="submit" class="btn btn-outline-primary w-100">Muat Naik</button>
                        </div>
                        <div class="col-12 form-text">
                            Maksimum 5 MB. Jenis dibenarkan: @FileUploadRules.AllowedExtensionsDisplay.
                        </div>
                    </form>
                </div>
            }
        </div>
    </div>

    <div class="col-lg-5">
        <div class="card mb-4">
            <div class="card-header">Status &amp; Tarikh</div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">No. Rujukan</dt>
                    <dd class="col-sm-7">
                        <code>@(string.IsNullOrWhiteSpace(Model.ReferenceNo) ? "(belum dijana)" : Model.ReferenceNo)</code>
                    </dd>

                    <dt class="col-sm-5">Status</dt>
                    <dd class="col-sm-7"><partial name="_StatusBadge" model="Model.Status" /></dd>

                    <dt class="col-sm-5">Dicipta</dt>
                    <dd class="col-sm-7">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</dd>

                    <dt class="col-sm-5">Dihantar</dt>
                    <dd class="col-sm-7">@(Model.SubmittedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>

                    <dt class="col-sm-5">Selesai</dt>
                    <dd class="col-sm-7">@(Model.CompletedAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "-")</dd>
                </dl>
            </div>
        </div>

        <div class="card">
            <div class="card-header">Jejak Audit</div>
            <div class="card-body">
                @if (Model.AuditTrail.Count == 0)
                {
                    <p class="text-muted mb-0">Tiada rekod audit.</p>
                }
                else
                {
                    <ul class="list-unstyled mb-0">
                        @foreach (var entry in Model.AuditTrail)
                        {
                            <li class="mb-3">
                                <div><strong>@entry.Action</strong></div>
                                <div class="small text-muted">
                                    @entry.ActorDisplayName &middot;
                                    @entry.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")
                                </div>
                                @if (!string.IsNullOrWhiteSpace(entry.Remarks))
                                {
                                    <div class="small">@entry.Remarks</div>
                                }
                            </li>
                        }
                    </ul>
                }
            </div>
        </div>
    </div>
</div>
