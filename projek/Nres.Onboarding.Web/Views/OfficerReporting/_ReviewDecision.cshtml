@model OfficerReportingDetailsViewModel
@*
    HR decision panel. Rendered only when the signed-in user may actually decide -
    but note that hiding a button is presentation, not security: the controller
    re-checks the role and the status on every POST.
*@
<div class="card border-primary mb-4">
    <div class="card-header bg-primary text-white">Keputusan Sumber Manusia</div>
    <div class="card-body">
        <div class="row g-4">
            <div class="col-md-5">
                <form asp-action="Approve" asp-route-id="@Model.SubmissionId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label for="approveRemarks" class="form-label">Catatan (pilihan)</label>
                        <textarea id="approveRemarks" name="remarks" class="form-control" rows="3"
                                  maxlength="1000" placeholder="Contoh: Dokumen lengkap."></textarea>
                    </div>
                    <button type="submit" class="btn btn-success">Luluskan</button>
                </form>
            </div>

            <div class="col-md-7 border-start">
                <form asp-action="Reject" asp-route-id="@Model.SubmissionId" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-2">
                        <label for="rejectReason" class="form-label">
                            Sebab penolakan <span class="text-danger">*</span>
                        </label>
                        @* required is a convenience for the user; the controller rejects an
                           empty reason regardless of what the browser sends. *@
                        <textarea id="rejectReason" name="reason" class="form-control" rows="3"
                                  maxlength="1000" required
                                  placeholder="Nyatakan sebab penolakan supaya pemohon boleh membetulkannya."></textarea>
                    </div>
                    <button type="submit" class="btn btn-danger">Tolak</button>
                </form>
            </div>
        </div>
    </div>
</div>
