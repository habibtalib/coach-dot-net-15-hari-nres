@model OfficerReportingCreateViewModel
@using Nres.Onboarding.Web.Services
@*
    Shared by Create and Edit so the two forms can never drift apart.
    Every input is bound with asp-for, which generates both the correct name attribute
    and the data-val-* attributes that drive client-side validation.
*@

<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

<div class="row g-3">
    <div class="col-md-6">
        <label asp-for="FullName" class="form-label"></label>
        <input asp-for="FullName" class="form-control" />
        <span asp-validation-for="FullName" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="IdentityNo" class="form-label"></label>
        <input asp-for="IdentityNo" class="form-control" />
        <span asp-validation-for="IdentityNo" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Email" class="form-label"></label>
        <input asp-for="Email" class="form-control" type="email" />
        <span asp-validation-for="Email" class="text-danger"></span>
    </div>

    <div class="col-md-6">
        <label asp-for="Phone" class="form-label"></label>
        <input asp-for="Phone" class="form-control" />
        <span asp-validation-for="Phone" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="DepartmentId" class="form-label"></label>
        <select asp-for="DepartmentId" asp-items="Model.Departments" class="form-select">
            <option value="">-- Pilih Jabatan --</option>
        </select>
        <span asp-validation-for="DepartmentId" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="PositionId" class="form-label"></label>
        <select asp-for="PositionId" asp-items="Model.Positions" class="form-select">
            <option value="">-- Pilih Jawatan --</option>
        </select>
        <span asp-validation-for="PositionId" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="GradeId" class="form-label"></label>
        <select asp-for="GradeId" asp-items="Model.Grades" class="form-select">
            <option value="">-- Pilih Gred --</option>
        </select>
        <span asp-validation-for="GradeId" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="ReportingDate" class="form-label"></label>
        <input asp-for="ReportingDate" class="form-control" type="date" />
        <span asp-validation-for="ReportingDate" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="PreviousAgency" class="form-label"></label>
        <input asp-for="PreviousAgency" class="form-control" />
        <span asp-validation-for="PreviousAgency" class="text-danger"></span>
    </div>

    <div class="col-md-4">
        <label asp-for="EmergencyContact" class="form-label"></label>
        <input asp-for="EmergencyContact" class="form-control" />
        <span asp-validation-for="EmergencyContact" class="text-danger"></span>
    </div>

    <div class="col-12">
        <label asp-for="Attachment" class="form-label"></label>
        <input asp-for="Attachment" class="form-control" type="file"
               accept="@string.Join(",", FileUploadRules.AllowedExtensions)" />
        <div class="form-text">
            Maksimum 5 MB. Jenis dibenarkan: @FileUploadRules.AllowedExtensionsDisplay.
            Sekurang-kurangnya satu dokumen sokongan diperlukan sebelum permohonan boleh dihantar.
        </div>
        <span asp-validation-for="Attachment" class="text-danger"></span>
    </div>
</div>
