# Build output
[Bb]in/
[Oo]bj/
[Oo]ut/

# IDE / editor
.vs/
.vscode/
.idea/
*.user
*.suo
*.userosscache
*.sln.docstates

# EF Core / SQLite training database
*.db
*.db-shm
*.db-wal

# Uploaded files.
# The folder itself is tracked (via .gitkeep) so a fresh clone can write to it
# immediately, but the uploaded documents themselves never belong in git.
# The first two lines re-open the folder, which the repository root .gitignore closes.
!App_Data/
!App_Data/uploads/
App_Data/uploads/*
!App_Data/uploads/.gitkeep

# Secrets - never commit real connection strings or keys
appsettings.*.local.json
secrets.json

# OS
.DS_Store
Thumbs.db
